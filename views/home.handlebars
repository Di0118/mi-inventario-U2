 <!-- Seccion de bienvenida -->
<div class="container text-center">
    <h1 class="mt-4">¡Bienvenida a tu Inventario de Amigurumis -ˋˏ✄┈┈┈┈!</h1>
    
    <!-- Botones  -->
    <div class="d-flex justify-content-center gap-3 mt-4 mb-5">
        <a href="/nuevo-producto" class="btn btn-success btn-lg shadow">
            𖹭📌 Nuevo Amigurumi
        </a>
        <a href="/api/productos" class="btn btn-primary btn-lg shadow">
            Ver JSON
        </a>
         <!-- Botón para chat -->
         <a href="/chat" class="btn btn-success" >Chat EnTiempoReal˗ˏˋ ꒰ ✉︎ ꒱ ˎˊ˗ </a>        
    </div>

    <hr>
    <!-- Contenedor de las Tarjetas -->
    <!-- barra de busqueda con autocompletar-->
   <div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form action="/" method="GET" class="input-group">
                
                <div class="flex-grow-1 position-relative"> 
    <input type="text" id="input-busqueda" name="buscar" class="form-control" 
           placeholder="¿Qué amigurumi buscas?" value="{{buscar}}" 
           list="sugerencias-list" autocomplete="off">
    <datalist id="sugerencias-list"></datalist>
</div>
                
                <button type="submit" class="btn btn-primary">Buscar ⌕</button>
                
                {{#if buscar}}
                    <a href="/" class="btn btn-outline-secondary">Limpiar</a>
                {{/if}}
            </form>
        </div>
    </div>
</div>
   <!-- Contenedor de las Tarjetas -->
<div class="row row-cols-1 row-cols-md-3 g-4">
    {{#each productos}}
    <div class="col">
        <div class="card h-100 shadow-sm border-0">
            <!-- Imagen con tamaño fijo -->
            <div style="height: 250px; overflow: hidden;">
                <img src="/uploads/{{this.imagen}}" class="card-img-top" alt="{{this.nombre}}" style="object-fit: cover; height: 100%; width: 100%;">
            </div>
            
            <div class="card-body d-flex flex-column">
                <h5 class="card-title text-capitalize text-center mb-3">{{this.nombre}}</h5>
                
                <!-- Precio y Stock alineaditos -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-5 fw-bold text-success">${{this.precio}}</span>
                    <span class="badge {{#if this.stock}}bg-info{{else}}bg-danger{{/if}} p-2">
                        Stock: {{this.stock}}
                    </span>
                </div>

                <p class="card-text text-muted small">{{this.descripcion}}</p>

                <!-- Botones al fondo -->
                <div class="mt-auto">
                    <div class="d-grid gap-2 mb-2">
                        <a href="/editar-producto/{{this._id}}" class="btn btn-outline-primary btn-sm">
                            Editar Detalles ✏️
                        </a>
                    </div>
                    <form action="/api/productos/eliminar/{{this._id}}" method="POST" class="d-grid gap-2">
                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('¿Borrar?')">
                            Eliminar ⌫
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {{/each}} 
</div>

<script>
    const inputBusqueda = document.getElementById('input-busqueda');
    const datalist = document.getElementById('sugerencias-list');

    inputBusqueda.addEventListener('input', async (e) => {
        const texto = e.target.value;
        if (texto.length > 0) {
            try {
                const respuesta = await fetch(`/api/buscar-sugerencias?q=${texto}`);
                const productos = await respuesta.json();
                datalist.innerHTML = ''; 
                productos.forEach(prod => {
                    const option = document.createElement('option');
                    option.value = prod.nombre;
                    datalist.appendChild(option);
                });
            } catch (err) {
                console.error("Error buscando:", err);
            }
        }
    });
</script>